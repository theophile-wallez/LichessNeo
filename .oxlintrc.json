{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "store/templates/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "rules": {
    "eslint/complexity": ["error", { "max": 15 }],
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/id-length": [
      "error",
      {
        "min": 2,
        "properties": "never",
        "exceptions": ["i", "j", "k", "x", "y", "z", "_", "T", "K"]
      }
    ],
    "eslint/max-depth": ["error", { "max": 4 }],
    "eslint/max-lines": ["error", { "max": 250, "skipBlankLines": true, "skipComments": true }],
    "eslint/max-lines-per-function": [
      "error",
      { "max": 60, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ],
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/no-await-in-loop": "off",
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/no-nested-ternary": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*", "../**"],
            "message": "Import from another folder through a # alias (package.json imports)."
          }
        ]
      }
    ],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-shadow": "off",
    "import/no-cycle": "error",
    "promise/valid-params": "off",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-imports": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }],
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-array-for-each": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["src/page/**", "src/shared/**"],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "chrome",
            "message": "The page world has no extension API: pass what it needs through the DOM or a message."
          },
          { "name": "browser", "message": "The page world has no extension API." }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "tests/**"],
      "rules": {
        "eslint/max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }],
        "eslint/max-lines-per-function": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    },
    {
      "files": ["scripts/**", "*.config.ts", "tests/e2e/login.ts"],
      "env": { "browser": false, "node": true },
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
