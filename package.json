{
  "name": "lichess-neo",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension that gives lichess.org a modern look and a Game Review.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#background/*": "./src/background/*",
    "#content/*": "./src/content/*",
    "#page/*": "./src/page/*",
    "#shared/*": "./src/shared/*",
    "#manifest": "./src/manifest.ts",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "preview": "node scripts/preview.ts",
    "turn": "node scripts/turn.ts",
    "playground": "node scripts/playground.ts",
    "package": "node scripts/package.ts",
    "store:render": "node scripts/store/render.ts",
    "icons": "node scripts/icons.ts",
    "typecheck": "node scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --grep-invert @slow",
    "test:firefox": "node --test tests/firefox/smoke.test.ts",
    "lichess:login": "node tests/e2e/login.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && node scripts/check-sources.ts",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm format:check && node scripts/check-sources.ts && vitest run --changed origin/main --passWithNoTests"
  },
  "dependencies": {
    "@foleyjs/core": "^2.9.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@puppeteer/browsers": "^3.2.5",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "puppeteer-core": "^25.14.0",
    "rolldown": "^1.2.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
